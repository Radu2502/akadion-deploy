# =============================================================================
# Akadion — .env pentru docker-compose.consolidat.yaml (DRAFT)
#
# Un singur fisier, pentru toata stiva. Inainte erau doua:
#   orchestration/.env               (interpolarea ${...} din compose)
#   orchestration/llm-response/.env  (citit prin env_file, doar de llm-response)
# si cheia Gemini trebuia completata in AMANDOUA. Compose-ul consolidat a
# renuntat la `env_file`, deci ramane doar fisierul asta.
#
# Utilizare:
#   cp draft/.env.example draft/.env
#   # completeaza GEMINI_API_KEY
#   docker compose -f draft/docker-compose.consolidat.yaml -p akadion up -d --build
#
# `docker compose` citeste automat fisierul .env de langa compose-ul rulat,
# adica din draft/. Daca muti compose-ul, muta si .env-ul.
# `.env` e deja in .gitignore-ul repo-ului (regula prinde orice subdirector);
# doar .env.example se comite.
#
# ATENTIE: `docker compose restart` NU reciteste .env.
# Dupa modificari aici: `docker compose up -d <serviciu>`.
# =============================================================================


# -----------------------------------------------------------------------------
# OBLIGATORIU — fara valoare implicita in compose.
# -----------------------------------------------------------------------------
# Cheie de la https://aistudio.google.com/apikey.
# O folosesc doua servicii: embedder (descriere de imagini din PDF) si
# llm-response (generarea raspunsului). Lasata goala, containerele pornesc, dar
# embedder-ul crapa la primul PDF cu imagini ("GEMINI_API_KEY nu este
# configurat"), iar llm-response nu poate genera raspuns.
GEMINI_API_KEY=


# -----------------------------------------------------------------------------
# Postgres — folosit si de backend, si de Keycloak (aceeasi baza).
# -----------------------------------------------------------------------------
DB_PASSWORD=secret


# -----------------------------------------------------------------------------
# MinIO — o singura pereche de credentiale pentru tot.
#
# Compose-ul consolidat mapeaza valorile astea si pe numele asteptate de
# clientii MinIO (MINIO_ACCESS_KEY / MINIO_SECRET_KEY la embedder si backend).
# Nu mai pune MINIO_ACCESS_KEY / MINIO_SECRET_KEY aici: erau numele din
# orchestration/.env pentru exact acelasi cont, si a le tine separat inseamna
# doar sansa de a le desincroniza.
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=MinioParola123!


# -----------------------------------------------------------------------------
# Keycloak — secretele clientilor backend-ului.
# Default-urile de mai jos sunt cele deja prezente in infra/docker-compose.yaml,
# reproduse ca sa mearga stiva de dezvoltare din prima. Nu sunt secrete reale
# de productie; daca ajung intr-un mediu expus, regenereaza-le din consola
# Keycloak si pune-le aici.
# -----------------------------------------------------------------------------
KEYCLOAK_BACKEND_LOGIN_SECRET=CXjLqtrWOxFIqujnPSHXmr8BssiFBqNH5L5t4UPUoT3b6mnli3hzH3E7HWo5AF8UJyKGf7ULfEGzbzdpd3eP5A
KEYCLOAK_ADMIN_API_SECRET=qkFpqAaDSjl4E9jcHgBe6kFJw0yRwpxWVs6waB1pitVQOboDQodvmbLbnt2pItjxHBeBwbVcVUddreumBT7BHf


# -----------------------------------------------------------------------------
# Basic auth intre servicii — backend -> llm-response/embedder si
# llm-response -> reranker/embedder folosesc aceeasi pereche.
# Daca o schimbi, o schimbi pentru toate patru deodata (de-asta e o singura
# variabila): un reranker cu alte credentiale intoarce 500, iar llm-response
# cade tacut pe raspuns fara reranking, fara eroare vizibila.
# -----------------------------------------------------------------------------
RAG_SERVICE_USERNAME=akadion-spring-backend
RAG_SERVICE_PASSWORD=parola_spring_rag


# -----------------------------------------------------------------------------
# Adrese interne. Nume de serviciu, valabile pe reteaua implicita a proiectului.
# Inainte erau nume de container (akadion-llm-response, akadion-embedder,
# akadion-backend), pentru ca serviciile stateau in proiecte compose diferite si
# se vedeau doar prin reteaua externa akadion_shared, care nu mai exista.
# -----------------------------------------------------------------------------
RAG_BASE_URL=http://llm-response:8000
RAG_EMBEDDER_URL=http://embedder:8001

# Callback-ul asincron embedder -> backend, pentru statusul procesarii imaginilor.
SPRING_BOOT_CALLBACK_URL=http://backend:8081/api/rag/documents/image-status
SPRING_BOOT_CALLBACK_USERNAME=akadion-embedder-callback
SPRING_BOOT_CALLBACK_PASSWORD=parola_callback_imagini


# -----------------------------------------------------------------------------
# Gemini — descrierea imaginilor din PDF (embedder).
# -----------------------------------------------------------------------------
GEMINI_VISION_MODEL=gemini-3.1-flash-lite
# Pauza intre apeluri, in secunde. 13.0 = ~4-5 cereri/minut, calibrat pentru
# limita planului gratuit. Coboara-l doar daca ai cheie platita.
GEMINI_REQUEST_DELAY_SECONDS=13.0
# Sub pragurile astea (pixeli) imaginea e ignorata — filtreaza iconite si linii.
MIN_IMAGE_WIDTH=100
MIN_IMAGE_HEIGHT=100
# Plafon per document; cu 13 s/imagine, 20 de imagini inseamna ~4 minute de ingest.
MAX_IMAGES_PER_DOCUMENT=20


# -----------------------------------------------------------------------------
# Gemini + Qdrant — generarea raspunsului (llm-response).
# Astea trei veneau din fostul orchestration/llm-response/.env.
# -----------------------------------------------------------------------------
GEMINI_MODEL=gemini-3.1-flash-lite
QDRANT_COLLECTION=course_chunks
# Nivel de log pentru llm-response (DEBUG / INFO / WARNING / ERROR).
LOG_LEVEL=INFO

# USE_QDRANT_MOCK nu mai e variabila de mediu: compose-ul o forteaza pe "false",
# ca si orchestrarea inainte. Mock-ul ocoleste baza vectoriala reala si n-are
# sens intr-o stiva pornita integral. Daca chiar ai nevoie de el, editeaza
# serviciul llm-response din compose (e marcat acolo cu # DECIZIE).


# =============================================================================
# Valori care NU sunt in .env — scrise direct in compose. Le listez ca sa stii
# unde sa le cauti, nu ca sa le adaugi aici (nu sunt citite din fisierul asta):
#
#   postgres    POSTGRES_DB=akadion, POSTGRES_USER=myuser
#   keycloak    KEYCLOAK_ADMIN=admin, KEYCLOAK_ADMIN_PASSWORD=admin,
#               realm=Akadion (importat din infra/keycloak-import/)
#   minio       bucket=course-documents (creat de minio-setup)
#   backend     APP_FRONTEND_BASE_URL=http://localhost:5173,
#               toate URL-urile Keycloak (http://keycloak:8080/realms/Akadion/...)
#   RAG         QDRANT_URL / QDRANT_HOST / QDRANT_PORT, RERANKER_URL, EMBEDDER_URL,
#               MINIO_BUCKET, LOG_FORMAT=json, SERVICE_NAME
#   tracing     OTEL_* (endpoint http://jaeger:4318, protocol http/protobuf)
#   toate       TZ=Europe/Bucharest
#
# Porturi pe host (fixe in compose, nu configurabile din .env):
#   5173 frontend | 8081 backend | 8080 keycloak | 5432 postgres
#   9000/9001 minio | 6333 qdrant | 8000 llm-response | 8001 embedder
#   8002 reranker | 16686 Jaeger UI | 4318 Jaeger OTLP
# =============================================================================
